# Build-time configuration for this site.
#
# These are GitHub repository VARIABLES, not Secrets. A value inlined into a
# client bundle is public the moment it ships, so putting it in Secrets buys
# nothing and hides it from whoever is auditing the site. Real secrets belong in
# `wrangler secret put`, where the browser never sees them.
#
#   gh variable set VITE_POSTHOG_KEY --body phc_...
#
# Every variable listed under `require-vars` in .github/workflows/deploy.yml is
# refused-if-missing at build time. Add a name in both places, or in neither.

# PostHog project API key ("Project API Key" in project settings, phc_...).
VITE_POSTHOG_KEY=

# Optional. Defaults to https://us.i.posthog.com when unset.
VITE_POSTHOG_HOST=
